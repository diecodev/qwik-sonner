{
  "name": "qwik-sonner",
  "version": "2.0.0-beta.3",
  "private": false,
  "description": "An opinionated toast component for Qwik.",
  "keywords": [
    "qwik",
    "qwik library",
    "qwik sonner",
    "sonner",
    "toast",
    "typescript"
  ],
  "author": {
    "name": "diecodev",
    "url": "https://github.com/diecodev"
  },
  "contributors": [
    {
      "name": "devalexpy",
      "url": "https://github.com/devalexpy"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diecodev/qwik-sonner.git"
  },
  "files": [
    "lib",
    "lib-types"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.qwik.mjs",
  "module": "./lib/index.qwik.mjs",
  "types": "./lib-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib-types/index.d.ts",
      "import": "./lib/index.qwik.mjs"
    },
    "./headless": {
      "types": "./lib-types/headless/toast-wrapper.d.ts",
      "import": "./lib/headless.qwik.mjs"
    }
  },
  "scripts": {
    "build": "pnpm run build.types && pnpm run build.lib",
    "build.lib": "vite build --mode lib",
    "build.types": "tsc --emitDeclarationOnly -p tsconfig.lib.json",
    "build.website": "pnpm build.types && pnpm build.lib && pnpm -C website build.client && pnpm -C website build.server",
    "dev": "pnpm --filter test dev",
    "dev.debug": "pnpm --filter test dev.debug",
    "fmt": "oxfmt .",
    "fmt.check": "oxfmt --check .",
    "lint": "oxlint .",
    "release": "bumpp --commit --tag --push",
    "prepublishOnly": "pnpm run build.types && pnpm run build.lib",
    "start": "pnpm --filter test start",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@qwik.dev/core": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "bumpp": "11.1.0",
    "eslint-plugin-qwik": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "undici": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@qwik.dev/core": "^2.0.0-rc.4"
  },
  "engines": {
    "node": ">=22.x"
  },
  "packageManager": "pnpm@12.15.0",
  "qwik": "./lib/index.qwik.mjs"
}
