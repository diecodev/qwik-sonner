{
  "name": "website",
  "private": true,
  "description": "Demo App with Routing built-in (recommended)",
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build -c adapters/ssg/vite.config.ts && node scripts/emit-404.mjs",
    "build.types": "tsc --incremental --noEmit",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "oxfmt",
    "fmt.check": "oxfmt --check",
    "lint": "oxlint src",
    "preview": "qwik build preview && vite preview --open",
    "start": "vite --open --mode ssr",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@qwik.dev/core": "catalog:",
    "@qwik.dev/router": "catalog:",
    "@types/node": "catalog:",
    "copy-to-clipboard": "4.0.2",
    "eslint-plugin-qwik": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "qwik-sonner": "workspace:*",
    "sugar-high": "2.6.0",
    "typescript": "catalog:",
    "undici": "catalog:",
    "vite": "catalog:"
  },
  "engines": {
    "node": ">=15.0.0"
  },
  "trustedDependencies": [
    "sharp"
  ]
}
